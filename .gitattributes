# 统一换行符，避免跨平台问题。
# 特别是 .sh / Dockerfile / 配置文件，在 Linux 上带 CRLF 会导致命令解析失败。

* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
*.example text eol=lf
Dockerfile text eol=lf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.db    binary
*.sqlite binary
