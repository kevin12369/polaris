# ===== Polaris 北极星 环境变量 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 端口：Web 界面对外暴露的端口
WEB_PORT=8080

# JWT 密钥 —— 生产环境必须改成随机长字符串
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-char-string

# 登录令牌有效期（小时）
TOKEN_TTL_HOURS=72

# 允许的跨域来源，生产环境建议填你的域名
CORS_ORIGINS=*

# ===== 可选：接入大模型（不配置也能完整使用）=====
# 任何 OpenAI 兼容接口都可以。配置后：
#   - 工单分类由大模型复核
#   - 排障步骤由大模型基于知识库内容生成
#   - 知识库摘要与通用化步骤自动生成
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 附件上传 =====
# 单文件大小上限（字节），默认 10 MB
ATTACHMENT_MAX_BYTES=10485760
# 单工单附件数量上限
ATTACHMENT_MAX_FILES_PER_TICKET=10
# 附件存储目录（默认 ${DATA_DIR}/attachments）
# ATTACHMENT_DIR=/app/data/attachments
